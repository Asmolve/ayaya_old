# PostgreSQL
POSTGRES_USER=ayaya
POSTGRES_PASSWORD=replace-with-a-unique-password
DATABASE_USERNAME=ayaya
DATABASE_PASSWORD=replace-with-a-unique-password
CORE_DATABASE_NAME=ayaya_core_development
NOTES_DATABASE_NAME=ayaya_mod_notes
DATABASE_HOST=postgres
DATABASE_PORT=5432

# Rails services
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true
CORE_ALLOWED_HOSTS=ayaya.local,localhost
NOTES_ALLOWED_HOSTS=ayaya.local,localhost,notes_app

# Notes integration
NOTES_ADAPTER_URL=http://notes_adapter:8080
NOTES_ADAPTER_SECRET=replace-with-a-unique-secret
NOTES_INTERNAL_STATUS_SECRET=replace-with-a-unique-secret
NOTES_APP_INTERNAL_STATUS_URL=http://notes_app:3000/internal/ayaya/status
NOTES_MODULE_YML=/module/module.yml

# Pic Obtainer integration
PIC_OBTAINER_ADAPTER_URL=http://pic_obtainer_api:8000
PIC_OBTAINER_IMAGE=pic-obtainer:latest
PIC_OBTAINER_POSTGRES_PASSWORD=replace-with-a-module-database-password
PIC_OBTAINER_DATABASE_URL=postgresql+psycopg://pic_obtainer:replace-with-url-encoded-password@pic_obtainer_postgres:5432/ayaya_mod_pic_obtainer
PIC_OBTAINER_MEDIA_HOST_PATH=/absolute/path/to/pic-obtainer-media
PIC_OBTAINER_IMPORT_HOST_PATH=/absolute/path/to/pic-obtainer-imports
PIC_OBTAINER_AYAYA_ADAPTER_SECRET=replace-with-a-module-adapter-secret
PIC_OBTAINER_RULE34_USER_ID=12345
PIC_OBTAINER_RULE34_API_KEY=replace-with-a-worker-secret

# Planning integration
PLANNING_DATABASE_NAME=ayaya_mod_planning
PLANNING_SECRET_KEY_BASE=replace-with-a-unique-secret
PLANNING_ADAPTER_URL=http://planning_adapter:8080
PLANNING_ADAPTER_SECRET=replace-with-a-module-adapter-secret
PLANNING_INTERNAL_STATUS_SECRET=replace-with-a-unique-secret

# Telegram integration (root deployment)
TELEGRAM_DATABASE_NAME=ayaya_mod_telegram
TELEGRAM_DATABASE_USERNAME=telegram
TELEGRAM_DATABASE_PASSWORD=replace-with-a-module-database-password
TELEGRAM_MTPROTO_DATABASE_NAME=ayaya_mod_telegram_mtproto
TELEGRAM_MTPROTO_DATABASE_USERNAME=telegram_mtproto
TELEGRAM_MTPROTO_DATABASE_PASSWORD=replace-with-a-transport-database-password
TELEGRAM_MTPROTO_SESSION_ENCRYPTION_KEY=replace-with-a-fernet-key
TELEGRAM_ADAPTER_URL=http://telegram_adapter:8080
TELEGRAM_ADAPTER_SECRET=replace-with-a-module-adapter-secret
TELEGRAM_INTERNAL_STATUS_SECRET=replace-with-a-unique-secret
TELEGRAM_TRUSTED_IDENTITY_SECRET=replace-with-a-unique-secret-shared-only-by-core-and-telegram-app
TELEGRAM_SECRET_KEY_BASE=replace-with-a-unique-rails-secret
TELEGRAM_ENVELOPE_KEY_FILE=/absolute/path/to/telegram-envelope-keyring.json
TELEGRAM_MTPROTO_CLIENT_URL=http://telegram_mtproto:8081
TELEGRAM_MTPROTO_CLIENT_TOKEN=replace-with-private-transport-token

# Host ports
CORE_HOST_PORT=3001
NGINX_HOST_PORT=3000
