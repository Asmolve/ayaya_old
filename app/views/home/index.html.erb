<main class="platform-main">
  <section class="platform-intro" aria-labelledby="modules-heading">
    <div>
      <p class="eyebrow">Your workspace</p>
      <h1 id="modules-heading">Modules</h1>
      <p class="platform-lede">Your connected tools, gathered in one quiet place.</p>
    </div>
    <p class="platform-count"><%= @modules.size %> available</p>
  </section>

  <% if @modules.any? %>
    <section class="module-list" aria-label="Available modules">
      <% @modules.each do |registered_module| %>
        <% presentation = registered_module.manifest_snapshot.fetch("presentation", {}) %>
        <article class="module-row">
          <div class="module-row__identity">
            <span class="module-row__glyph" aria-hidden="true"><%= registered_module.name.first.upcase %></span>
            <div>
              <h2><%= registered_module.name %></h2>
              <p><%= presentation["description"].presence || "Open this module" %></p>
            </div>
          </div>
          <%= link_to "Open #{registered_module.name}", "/m/#{registered_module.module_key}", class: "module-row__action" %>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="empty-state">
      <span class="empty-state__glyph" aria-hidden="true">—</span>
      <h2>No modules available</h2>
      <p>When a module is enabled, it will appear here.</p>
    </section>
  <% end %>
</main>
