<main>
  <header>
    <h1>Notes</h1>
    <%= link_to "New note", new_note_path %>
  </header>

  <% if @notes.any? %>
    <ul>
      <% @notes.each do |note| %>
        <li><%= link_to note.title, note_path(note) %></li>
      <% end %>
    </ul>
  <% else %>
    <p>No notes yet.</p>
  <% end %>
</main>
