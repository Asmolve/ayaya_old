<main class="notes-page">
  <nav class="notes-mode-nav" aria-label="Notes mode">
    <%= link_to "Notes", notes_root_path, aria: { current: "page" } %>
    <%= link_to "Diary", diary_path %>
  </nav>

  <header class="notes-page__header">
    <div>
      <p class="notes-eyebrow">Reference module</p>
      <h1>Notes</h1>
      <p class="notes-lede">Short thoughts and longer ideas, kept close at hand.</p>
    </div>
    <%= link_to "New note", new_note_path, class: "notes-primary-action" %>
  </header>

  <% if @notes.any? %>
    <ul class="notes-list">
      <% @notes.each do |note| %>
        <li class="notes-list__item">
          <%= link_to note_path(note) do %>
            <strong><%= note.title %></strong>
            <span><%= note.diary? ? "#{note.start_date.strftime("%d.%m.%Y")} — #{note.end_date.strftime("%d.%m.%Y")}" : "Note" %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <section class="notes-empty">
      <span aria-hidden="true">✦</span>
      <h2>No notes yet</h2>
      <p>Start with one small thought.</p>
      <%= link_to "Create a note", new_note_path, class: "notes-text-action" %>
    </section>
  <% end %>
</main>
