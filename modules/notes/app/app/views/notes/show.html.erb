<main class="notes-page notes-detail">
  <%= link_to "← All notes", notes_root_path, class: "notes-back-link notes-back-link--content" %>
  <header class="notes-detail__header">
    <h1><%= @note.title %></h1>
    <div class="notes-detail__actions">
      <%= link_to "Edit", edit_note_path(@note), class: "notes-secondary-action" %>
      <%= button_to "Delete", note_path(@note), method: :delete, class: "notes-danger-action", data: { turbo_confirm: "Delete this note?" } %>
    </div>
  </header>

  <div class="note-content">
    <% if @note.diary? %>
      <%= @note.diary_content %>
    <% else %>
      <%= simple_format(@note.body) %>
    <% end %>
  </div>

</main>
