<main class="planning-workspace">
  <section class="priority-surface">
    <h1>Edit item</h1>
    <%= form_with model: @plan_item do |form| %>
      <% @plan_item.errors.full_messages.each do |message| %><p><%= message %></p><% end %>
      <%= form.label :title %>
      <%= form.text_field :title, required: true %>
      <%= form.label :notes %>
      <%= form.text_area :notes %>
      <%= form.label :priority %>
      <%= form.select :priority, PlanItem.priorities.keys.map { |priority| [priority.capitalize, priority] } %>
      <%= form.label :completed %>
      <%= form.checkbox :completed %>
      <%= form.submit "Save item" %>
    <% end %>
  </section>
</main>
