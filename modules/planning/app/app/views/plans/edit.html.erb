<main class="planning-workspace">
  <section class="priority-surface">
    <h1>Edit plan</h1>
    <%= form_with model: @plan do |form| %>
      <% @plan.errors.full_messages.each do |message| %><p><%= message %></p><% end %>
      <%= form.label :title %>
      <%= form.text_field :title, required: true %>
      <%= form.submit "Save plan" %>
    <% end %>
  </section>
</main>
